<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="phlix-shared">
    <description>PSR-12 coding standard for detain/phlix-shared.</description>

    <file>src</file>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <!-- The 'n' flag (phpcs no-warnings) hid warnings from bare
         `vendor/bin/phpcs` local runs — the same defect class as the removed
         `-n` on the CI src/ step (2026-10-02 audit). src/ is measured 0 errors
         / 0 warnings, so warnings must be visible and must fail here too. -->
    <arg value="p"/>

    <rule ref="PSR12"/>
</ruleset>
